# Server port (default: 3000)
PORT=3000

# Interface the server listens on (default: 127.0.0.1, this machine only).
HOST=127.0.0.1

# Default repositories shown in the form on startup.
# Format: owner/repo — comma-separated for multiple repos.
DEFAULT_REPOS=torvalds/linux,microsoft/vscode

# Default label filter pre-filled in the form (leave empty to disable).
DEFAULT_LABEL=bug

# Default team members pre-filled in the form.
# Format: comma-separated GitHub handles.
DEFAULT_TEAM=torvalds,DHowett,joaomoreno,eamodio

# Bots that use regular user accounts, such as a CI or release account.
# GitHub Apps and logins ending in [bot] are recognized without this list.
# Format: comma-separated GitHub logins, case-insensitive.
BOT_LOGINS=

# Time-to-live in hours for the cached list of PRs matching a query
# (repositories, label and date range). Analysis runs on every request,
# so changing the team list does not refetch.
CACHE_TTL_HOURS=6

# Time-to-live in days for each cached PR (data and reviews). A cached PR is
# reused while its updatedAt on GitHub is unchanged.
PR_CACHE_TTL_DAYS=30

# Optional cache directory (relative to project root or absolute path).
CACHE_DIR=.cache/pr-reviews-analysis

# Bun idle timeout for plain JSON requests to /api/analyze, in seconds. The web app's
# progress stream is exempt. 0 disables the timeout; finite values must be 1..255.
ANALYZE_IDLE_TIMEOUT_SECONDS=0
